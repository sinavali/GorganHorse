# Gorgan Horse Federation Panel — Nginx sample configuration.
# Copy to your Nginx sites-available directory and adjust paths/domains.

server {
    listen 80;
    server_name panel.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name panel.example.com;

    root /var/www/gorgan-panel/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;

    client_max_body_size 30m;

    # Deny direct access to application-sensitive folders. These live outside the
    # web root on a correct deployment, but the rule keeps a mis-pointed root safe.
    location ~ ^/(app|database|vendor|cache|logs|backups|cultures|tests)/ {
        deny all;
        return 404;
    }

    # Entry points that must never be requested directly.
    location ~ ^/(router|cron)\.php$ {
        deny all;
        return 404;
    }

    # Serve the SPA's static assets directly (fonts, vendored Quill, CSS, JS).
    # These are the only files read from disk by the web server; uploads live
    # outside the web root and are streamed through GET /media/{id}.
    location /views/assets/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Font files must be served with the right type and CORS-free same-origin.
    location ~ ^/views/assets/fonts/.*\.woff2$ {
        try_files $uri =404;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}